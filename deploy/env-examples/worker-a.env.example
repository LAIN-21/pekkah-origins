# Worker A: the existing GPU droplet `pekkah` (RTX 4000 Ada 20 GB, 8 vCPU, 32 GB).
# Copied by scripts/init-env.sh to ~/.pekkah/env/worker-a.env.
# PAYOUT_ADDRESS is Seller A's address (also SELLER_A_ADDRESS on the market).
#
# @optional SCHEDULE
# @generate WORKER_TOKEN

WORKER_ID=A
WORKER_NAME="Worker A"
WORKER_TOKEN=
MARKET_WS_URL=
PAYOUT_ADDRESS=
PRICE_FRACTAL_USD=0.05
PRICE_IMAGE_USD=0.05
SCHEDULE=
JOB_CPUS=6
JOB_MEMORY=8g
FRACTAL_IMAGE=pekkah/fractal:local
FLUX_URL=http://flux:8000
DATA_DIR=/var/lib/pekkah
