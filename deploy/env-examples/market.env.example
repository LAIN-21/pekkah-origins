# Market host (compose project pekkah-market): caddy, market, facilitator, agent.
# Copied by scripts/init-env.sh to ~/.pekkah/env/market.env. Names and
# non-secret defaults only: secrets stay empty here and init-env.sh writes
# __FILL_ME__ for them. Compose gives each container only the names it needs,
# so the market container never sees BUYER_MNEMONIC.
#
# Fixed in market.compose.yml (wiring between the containers, not read from this
# file): MARKET_PORT=8080, FACILITATOR_HOST=0.0.0.0, FACILITATOR_PORT=4022,
# FACILITATOR_URL=http://facilitator:4022, AGENT_PORT=4100,
# AGENT_URL=http://agent:4100, MARKET_URL=http://market:8080.
#
# @optional SELLER_A_MNEMONIC PEKKAH_DEV_ROUTES OPEN_WORKER_JOIN
# @generate AGENT_TOKEN DEMO_TOKEN

# caddy: <ip-with-dashes>.sslip.io for HTTPS, or http://<reserved-ip> for plain HTTP
PUBLIC_HOST=

# market
PUBLIC_URL=
FACILITATOR_TIMEOUT_MS=120000
PEKKAH_ASSET=e675b46e4d2242c991a8932a99db3044e80515ae14b4c4ccf6b3f4c9.0014df10745553444d
L1_CONFIRMATIONS=0
WORKER_TOKENS=
AGENT_TOKEN=
DEMO_TOKEN=
DEMO_COOLDOWN_SEC=120
DEMO_DAILY_RUNS=40
DATA_DIR=/var/lib/pekkah
PEKKAH_DEV_ROUTES=1
SELLER_A_ADDRESS=
SELLER_B_ADDRESS=
SELLER_C_ADDRESS=
SELLER_A_MNEMONIC=""
# 1 lets workers without an allowlisted token join on probation (PLAN2 PR-17): listed and
# measured, never sold. Empty or 0 keeps joining closed.
OPEN_WORKER_JOIN=

# facilitator
BLOCKFROST_PROJECT_ID=
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
CONFIRMATION_TIMEOUT_MS=75000
ACCEPT_MEMPOOL=false

# agent (service mode; also uses BLOCKFROST_*, PEKKAH_ASSET, AGENT_TOKEN above)
BUYER_MNEMONIC=""
BUYER_ACCOUNT_INDEX=0
CAP_PER_PAYMENT_USD=0.10
CAP_RUN_USD=0.20
CAP_DAY_USD=5
AGENT_MODE=service
