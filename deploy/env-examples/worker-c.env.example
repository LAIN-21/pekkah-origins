# Worker C: pekkah-worker-c (2 vCPU, 2 GB).
# Copied by scripts/init-env.sh to ~/.pekkah/env/worker-c.env.
# PAYOUT_ADDRESS is Seller C's address (also SELLER_C_ADDRESS on the market).
#
# @optional SCHEDULE PRICE_IMAGE_USD FLUX_URL
# @generate WORKER_TOKEN

WORKER_ID=C
WORKER_NAME="Worker C"
WORKER_TOKEN=
MARKET_WS_URL=
PAYOUT_ADDRESS=
PRICE_FRACTAL_USD=0.02
PRICE_IMAGE_USD=
SCHEDULE=
JOB_CPUS=2
JOB_MEMORY=1g
FRACTAL_IMAGE=pekkah/fractal:local
FLUX_URL=
DATA_DIR=/var/lib/pekkah
