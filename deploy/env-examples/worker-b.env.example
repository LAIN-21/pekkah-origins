# Worker B: pekkah-worker-b (8 vCPU, 16 GB).
# Copied by scripts/init-env.sh to ~/.pekkah/env/worker-b.env.
# PAYOUT_ADDRESS is Seller B's address (also SELLER_B_ADDRESS on the market).
#
# @optional SCHEDULE PRICE_IMAGE_USD FLUX_URL
# @generate WORKER_TOKEN

WORKER_ID=B
WORKER_NAME="Worker B"
WORKER_TOKEN=
MARKET_WS_URL=
PAYOUT_ADDRESS=
PRICE_FRACTAL_USD=0.03
PRICE_IMAGE_USD=
SCHEDULE=
JOB_CPUS=8
JOB_MEMORY=8g
FRACTAL_IMAGE=pekkah/fractal:local
FLUX_URL=
DATA_DIR=/var/lib/pekkah
